# Hybrid Origami Pipeline — API Keys
#
# Copy this file to .env and fill in the key for the model you want to use.
# Only the key for your chosen provider needs to be set.
#
# Provider is inferred from the model ID in config.py (or FoldingAgent's config.py):
#   gemini-*          → GOOGLE_API_KEY
#   claude-*          → ANTHROPIC_API_KEY
#   gpt-*, o1/o3/o4-* → OPENAI_API_KEY
#
# Default model: gemini-* → set GOOGLE_API_KEY

# --- Google (Gemini) ---
# Used by: FoldingAgent core (reconstruction loop + critic)
#          EvidenceGrounder (Anveshan epistemic tagging)
#          RubricSynthesizer (LLM-based criteria synthesis)
GOOGLE_API_KEY=

# --- Anthropic (Claude) ---
# Used by: FoldingAgent core if you set DEFAULT_MODEL to a claude-* model
ANTHROPIC_API_KEY=

# --- OpenAI ---
# Used by: FoldingAgent core if you set DEFAULT_MODEL to a gpt-* / o-series model
OPENAI_API_KEY=
