# Hybrid Origami Pipeline — API Keys & Model Configuration
#
# Copy this file to .env and fill in values.
# Only the key(s) for the provider(s) you use need to be set.
#
# ============================================================
# API KEYS
# ============================================================
#
# Provider is inferred from the model ID:
#   gemini-*          → GOOGLE_API_KEY
#   claude-*          → ANTHROPIC_API_KEY
#   gpt-*, o1/o3/o4-* → OPENAI_API_KEY
#
# Used by TWO different components — you can use the same key or separate keys:
#
#   1. FoldingAgent (geometric reconstruction ReAct loop + critic)
#      Runs many calls (50-200+ per origami sequence). Free tier likely
#      insufficient for a full run. Recommended: paid key or Claude.
#      FoldingAgent reads from environment variables directly.
#      To use our .env for FoldingAgent too, run:
#        cd <FoldingAgent repo root>
#        set-location ..; python -c "from dotenv import load_dotenv; load_dotenv('anveshan/research/origami_hybrid/.env')"
#      Or simply export the key in your shell before running FoldingAgent.
#
#   2. Hybrid pipeline (EvidenceGrounder + RubricSynthesizer enrichment)
#      Uses 1 call per claim (small, typically 2-10 calls per run).
#      Free tier (20 req/day) is sufficient for offline fixture testing.

# --- Google (Gemini) ---
GOOGLE_API_KEY=

# --- Anthropic (Claude) ---
# Recommended for FoldingAgent — Anthropic free tier is more generous
# for multi-turn agentic workloads than Gemini free tier.
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# ============================================================
# MODEL CONFIGURATION
# ============================================================
#
# HYBRID_MODEL: model used by the hybrid pipeline's LLM enrichment steps
#   (EvidenceGrounder v2 and GeminiRubricSynthesizer v2).
#   Must match the provider whose API key you have set above.
#   Examples:
#     gemini-3.8-flash          (Google — default)
#     claude-3-5-haiku-20241022 (Anthropic)
#     gpt-4o-mini               (OpenAI)
#
HYBRID_MODEL=gemini-3.8-flash

# HYBRID_FALLBACK_MODEL: used if HYBRID_MODEL is unavailable or returns 404.
#   Leave blank to disable fallback (pipeline will raise on model errors).
#
HYBRID_FALLBACK_MODEL=

# FOLDINGAGENT_MODEL: model used by FoldingAgent's reconstruction loop.
#   Defaults to gemini-3.1-pro-preview in FoldingAgent's own config.py.
#   Set here for reference — you must also update FoldingAgent/src/foldingagent/config.py
#   or pass it via the run command if FoldingAgent supports model override.
#
FOLDINGAGENT_MODEL=gemini-3.8-flash
