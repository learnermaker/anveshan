%% Purpose:
%% Two developers can build and validate independently.
%% The contract seam is the coordination boundary; fixtures provide independence.
%% This diagram is an execution map, not product scope.

flowchart TB
  START[Current gate: M0<br/>validate capability] --> CONTRACT[Freeze small cross-track contracts]
  CONTRACT --> A
  CONTRACT --> B

  subgraph A[TRACK A — EXPERT INTELLIGENCE & GROUNDING]
    A0[Authentic source fixture] --> A1[Understand<br/>actions • conditions • cues • exceptions]
    A1 --> A2[Structure knowledge]
    A2 --> A3[Ground claims<br/>claim → evidence reference]
    A3 --> A4[Generate lesson + practice task]
    A4 --> A5[Replay validation<br/>fidelity • grounding • expert review]
  end

  subgraph B[TRACK B — PRACTICE, EVALUATION & TRANSMISSION]
    B0[Frozen KnowledgePackage fixture] --> B1[Practice task]
    B1 --> B2[Baseline + attempt capture]
    B2 --> B3[Evaluate<br/>observable rubric]
    B3 --> B4[Evidence-linked feedback]
    B4 --> B5[Retry + second attempt]
    B5 --> B6[Measure change<br/>criterion-level gain]
    B6 --> B7[Transmission record + lineage]
    B7 --> B8[Replay validation<br/>evaluation • feedback • gain]
  end

  CONTRACT:::shared -. contract .-> A
  CONTRACT:::shared -. contract .-> B
  A5:::proof -. independent proof .-> AREADY[Track A ready for integration]
  B8:::proof -. independent proof .-> BREADY[Track B ready for integration]

  AREADY --> INTEGRATE[Integration point<br/>replace fixtures with real expert + learner evidence]
  BREADY --> INTEGRATE
  INTEGRATE --> MVP[Smallest credible vertical slice]
  MVP --> MEASURE[Transmission measurement]
  MEASURE --> HARDEN[Harden only against observed failures]
  HARDEN --> DEMO[Demo / submission path]

  NOTE[Shared contract examples<br/>KnowledgePackage • EvidenceRef • PracticeTask<br/>LearnerAttempt • Evaluation • Feedback • TransmissionRecord]
  CONTRACT --> NOTE

  GATE[No hidden synchronization<br/>No shared-file ownership collision<br/>No implementation dependency on the other track]
  CONTRACT --> GATE

