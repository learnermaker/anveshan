# Copy to .env and fill in. Never commit .env.
# Server-side only: the browser never receives these values.

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model registry (see .claude/skills/model-gateway). Gemma 4 is free on AI Studio.
ANVESHAN_TEXT_IMAGE_MODEL=gemma-4-26b-a4b-it
ANVESHAN_VIDEO_FRAMES_MODEL=gemma-4-26b-a4b-it
# Optional, paid (~$0.0003 per 12 s clip, measured 2026-10-06): audio model for tabla bol names
# (labelled INFERRED, never scored). Leave empty to disable
# (audio timing stays fully deterministic; bol criteria become UNCERTAIN).
ANVESHAN_AUDIO_MODEL=gemini-3.5-flash-lite
# Universal pipeline (measured 2026-10-06): vision_fast ~2.5 s/image (~$0.0003); embeddings 5 images in 1.3 s.
ANVESHAN_VISION_FAST_MODEL=gemini-3.5-flash-lite
ANVESHAN_EMBEDDING_MODEL=gemini-embedding-2

# Runtime
ANVESHAN_MODE=recorded            # live | recorded
ANVESHAN_CASES_ROOT=tracks/cases
ANVESHAN_DATA_DIR=var             # uploads, sessions, ad-hoc runs (gitignored)
ANVESHAN_MAX_UPLOAD_MB=50
ANVESHAN_CORS_ORIGINS=http://localhost:5173
ANVESHAN_STATIC_DIR=app/dist     # set empty to disable static file serving (API-only mode)

# Model call timeout in milliseconds (default 300000 = 5 min).
# Gemma image-call latency: text ~4-7 s, 1 image ~43 s, 4+ images may 504 at 120 s.
# Increase here if calls time out; set to 120000 for latency probes to get clean 504 signals.
ANVESHAN_MODEL_TIMEOUT_MS=300000

# Steward access control (K9-P1; set as a Cloud Run secret in production)
# ANVESHAN_STEWARD_TOKEN=   (long random code; on Cloud Run set it as a secret)
# ANVESHAN_STEWARD_OPEN=0
# Token economy (docs/architecture/token-economy.md)
ANVESHAN_MEDIA_RESOLUTION=auto    # auto | low | medium | high | default (Gemini 3 image billing level)
ANVESHAN_MAX_OUTPUT_TOKENS=4096   # cap on answer + thinking tokens per call; 0 = no cap
ANVESHAN_LIVE_CACHE=1             # reuse an identical earlier call at no cost; 0 for variance studies
ANVESHAN_DAILY_CALL_BUDGET=0      # max shared-key model calls per day; 0 = unlimited (set on Cloud Run)
