{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "app-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev:mock"
      ],
      "port": 5174
    },
    {
      "name": "service",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "anveshan_service.main:app",
        "--app-dir",
        "service",
        "--port",
        "8080"
      ],
      "port": 8080
    },
    {
      "name": "app-mock-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "--",
        "vite",
        "--mode",
        "mock",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199,
      "cwd": "app"
    },
    {
      "name": "app-8090",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "--",
        "vite",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180,
      "cwd": "app",
      "env": {
        "ANVESHAN_API_PROXY": "http://localhost:8090"
      }
    }
  ]
}
